# YouTube Data API v3 key (required)
YOUTUBE_API_KEY=your_youtube_api_key_here

# Channel settings
# Set CHANNEL_ID directly if known, or leave blank to search by CHANNEL_NAME
CHANNEL_ID=
CHANNEL_NAME=空想ロマンス

# Member names (comma-separated) for mention analysis
MEMBER_NAMES=

# AI provider: auto | ollama | openai | claude | none
# 'auto' tries Ollama → OpenAI → Claude in order, falls back to none
AI_PROVIDER=auto

# Ollama (local LLM - free)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# OpenAI compatible API (optional)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Claude API (optional)
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5-20251001

# Analysis thresholds
BUZZ_THRESHOLD=2.0
MOMENTUM_THRESHOLD=1.5
DB_SIZE_WARN_MB=400
DB_SIZE_ARCHIVE_MB=500
