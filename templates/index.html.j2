<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ data.channel_metrics.channel_name }} - YouTube Analytics Dashboard</title>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<style>
  body { background: #0d1117; color: #e6edf3; font-family: 'Segoe UI', system-ui, sans-serif; }
  .hero { background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%); padding: 3rem 0 2.5rem; }
  .kpi-card { background: #161b22; border: 1px solid #30363d; border-radius: 12px; padding: 1.25rem; }
  .kpi-value { font-size: 2rem; font-weight: 700; color: #58a6ff; }
  .kpi-label { color: #8b949e; font-size: .82rem; text-transform: uppercase; letter-spacing: .05em; }
  .kpi-delta-pos { color: #3fb950; }
  .kpi-delta-neg { color: #f85149; }
  .section { background: #161b22; border: 1px solid #30363d; border-radius: 12px; padding: 1.5rem; margin-bottom: 1.5rem; }
  .report-link { background: #21262d; border: 1px solid #30363d; border-radius: 8px; padding: .75rem 1rem; margin-bottom: .5rem; display: flex; justify-content: space-between; align-items: center; }
  .report-link a { color: #58a6ff; text-decoration: none; }
  .report-link a:hover { color: #79c0ff; }
  .chart-img { max-width: 100%; border-radius: 8px; border: 1px solid #30363d; }
  .badge-shorts { background: #ff4b5c22; color: #ff4b5c; border: 1px solid #ff4b5c44; }
  .badge-regular { background: #4c9be822; color: #4c9be8; border: 1px solid #4c9be844; }
  .ai-section { background: linear-gradient(135deg, #667eea22, #764ba222); border-left: 3px solid #667eea; border-radius: 0 8px 8px 0; }
  table { color: #e6edf3; }
  .table-dark-custom thead th { background: #21262d; border-color: #30363d; }
  .table-dark-custom tbody tr:hover td { background: #1f262f; }
  .table-dark-custom td, .table-dark-custom th { border-color: #30363d; }
  a { color: #58a6ff; }
  h2, h3, h4, h5 { color: #f0f6fc; }
</style>
</head>
<body>

<div class="hero text-white">
  <div class="container">
    <div class="row align-items-center mb-3">
      <div class="col">
        <h1 class="fw-bold mb-1">📊 {{ data.channel_metrics.channel_name }}</h1>
        <p class="opacity-75 mb-0">YouTube Analytics Dashboard &nbsp;|&nbsp; 最終更新: {{ generated_at }}</p>
      </div>
      <div class="col-auto">
        <a href="live.html" style="background:#21262d; border:1px solid #30363d; border-radius:8px; padding:.4rem 1rem; color:#3fb950; text-decoration:none; font-size:.9rem;">⚡ ライブ（毎時更新）→</a>
      </div>
    </div>
  </div>
</div>

<div class="container py-4">

  <!-- KPI Row -->
  {% set cm = data.channel_metrics %}
  <div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
      <div class="kpi-card">
        <div class="kpi-label">登録者数</div>
        <div class="kpi-value">{{ cm.current_subscribers | format_int }}</div>
        <div class="{% if cm.delta_subscribers_24h >= 0 %}kpi-delta-pos{% else %}kpi-delta-neg{% endif %} small">
          {{ "%+d" | format(cm.delta_subscribers_24h) }} (24h)
        </div>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="kpi-card">
        <div class="kpi-label">総再生数</div>
        <div class="kpi-value">{{ cm.current_views | format_int }}</div>
        <div class="{% if cm.delta_views_24h >= 0 %}kpi-delta-pos{% else %}kpi-delta-neg{% endif %} small">
          {{ "%+d" | format(cm.delta_views_24h) }} (24h)
        </div>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="kpi-card">
        <div class="kpi-label">動画本数</div>
        <div class="kpi-value">{{ cm.current_video_count }}</div>
        <div class="text-muted small">月間 {{ cm.posts_per_month | format_float2 }}本</div>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="kpi-card">
        <div class="kpi-label">Shorts比率</div>
        <div class="kpi-value">{{ cm.shorts_ratio | format_pct }}</div>
        <div class="text-muted small">週 {{ cm.posts_per_week | format_float2 }}本</div>
      </div>
    </div>
  </div>

  <!-- Hourly Views Chart -->
  {% if data.hourly_chart_labels_json %}
  <div class="section mb-4">
    <h4 class="mb-3">📈 今日の時間別再生数増加</h4>
    <canvas id="hourlyViewsChart" height="80"></canvas>
    <script>
    (function(){
      var labels = {{ data.hourly_chart_labels_json | safe }};
      var deltas = {{ data.hourly_chart_deltas_json | safe }};
      new Chart(document.getElementById('hourlyViewsChart'), {
        type: 'bar',
        data: {
          labels: labels,
          datasets: [{
            label: '再生数増加（回/時）',
            data: deltas,
            backgroundColor: deltas.map(function(v) {
              return v === null ? 'rgba(200,200,200,0.1)' : 'rgba(88,166,255,0.7)';
            }),
            borderColor: deltas.map(function(v) {
              return v === null ? 'rgba(200,200,200,0.2)' : '#58a6ff';
            }),
            borderWidth: 1,
          }]
        },
        options: {
          responsive: true,
          plugins: {
            legend: { labels: { color: '#e6edf3' } },
            tooltip: {
              callbacks: {
                label: function(ctx) {
                  var v = ctx.raw;
                  return v === null ? 'データなし' : '+' + v.toLocaleString() + ' 回';
                }
              }
            }
          },
          scales: {
            x: {
              ticks: { color: '#8b949e', maxRotation: 45 },
              grid: { color: '#30363d' }
            },
            y: {
              min: 0,
              ticks: { color: '#8b949e', callback: function(v) { return v.toLocaleString() + ' 回'; } },
              grid: { color: '#30363d' },
              title: { display: true, text: '再生数増加（回/時）', color: '#8b949e' }
            }
          }
        }
      });
    })();
    </script>
  </div>
  {% endif %}

  <!-- Graphs -->
  {% if data.graph_paths %}
  <div class="section mb-4">
    <h4 class="mb-3">📈 最新グラフ</h4>
    <div class="row g-3">
      {% for name, path in data.graph_paths.items() %}
      <div class="col-12 col-lg-6">
        <img src="graphs/{{ path | basename }}" alt="{{ name }}" class="chart-img w-100">
      </div>
      {% endfor %}
    </div>
  </div>
  {% endif %}

  <!-- Content Types -->
  <div class="section mb-4">
    <h4 class="mb-3">🎬 コンテンツタイプ別集計</h4>
    <div class="table-responsive">
      <table class="table table-sm table-dark-custom mb-0">
        <thead><tr><th>タイプ</th><th>本数</th><th>平均再生数</th><th>総再生数</th></tr></thead>
        <tbody>
          {% for s in data.content_type_stats %}
          <tr><td>{{ s.content_type }}</td><td>{{ s.video_count }}</td><td>{{ s.avg_views | format_int }}</td><td>{{ s.total_views | format_int }}</td></tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>

  <!-- Rising Videos -->
  <div class="section mb-4">
    <h4 class="mb-3">🚀 急上昇動画 TOP10（24h）</h4>
    <div class="table-responsive">
      <table class="table table-sm table-dark-custom align-middle mb-0">
        <thead><tr><th>#</th><th>タイトル</th><th>+24h</th><th>勢い</th></tr></thead>
        <tbody>
          {% for v in data.rising_videos[:10] %}
          <tr>
            <td class="text-muted">{{ loop.index }}</td>
            <td>
              <a href="https://www.youtube.com/watch?v={{ v.video_id }}" target="_blank">{{ v.title[:35] }}{% if v.title | length > 35 %}…{% endif %}</a>
              <br><span class="badge {% if v.video_type == 'shorts' %}badge-shorts{% else %}badge-regular{% endif %} small">{{ v.video_type }}</span>
            </td>
            <td class="kpi-delta-pos">+{{ v.delta_24h | format_int }}</td>
            <td>{{ v.momentum_index | format_float2 }}</td>
          </tr>
          {% else %}
          <tr><td colspan="4" class="text-center text-muted">データなし</td></tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>

  <!-- AI Analysis -->
  <div class="section mb-4">
    <h4 class="mb-3">🤖 AI分析レポート</h4>
    {% if data.ai_analysis %}
    <div class="ai-section p-3">
      <div id="ai-content-index"></div>
      <script>
        document.getElementById('ai-content-index').innerHTML =
          marked.parse({{ data.ai_analysis | tojson }});
      </script>
    </div>
    {% else %}
    <div class="text-muted small">AI分析は利用できません。環境変数でAIプロバイダーを設定してください。</div>
    {% endif %}
  </div>

  <!-- Past Reports -->
  <div class="section mb-4">
    <h4 class="mb-3">📋 過去レポート</h4>
    {% for r in recent_reports[:20] %}
    <div class="report-link">
      <a href="report_{{ r.report_date }}.html">{{ r.report_date }} レポート</a>
      <small class="text-muted">{{ r.generated_at | utc_to_jst }}</small>
    </div>
    {% else %}
    <p class="text-muted">レポートなし</p>
    {% endfor %}
  </div>

</div>

<footer class="text-center py-3" style="color:#8b949e; border-top: 1px solid #30363d;">
  <small>{{ data.channel_metrics.channel_name }} Analytics &nbsp;|&nbsp; Generated {{ generated_at }}</small>
</footer>
</body>
</html>
